# ── Email (Resend) ──────────────────────────────────────────
# Opret gratis konto på https://resend.com
# Kopiér din API-nøgle hertil
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Den email-adresse henvendelser sendes til
CONTACT_EMAIL=info@augustraadogbyg.dk

# ── Database (Supabase) — valgfri, men anbefalet ────────────
# Opret gratis projekt på https://supabase.com, kør supabase/schema.sql
# i SQL Editor, og hent URL + service_role-nøgle under Project Settings → API.
# Uden disse virker formularerne stadig (sender bare email), men leads
# gemmes ikke til senere opslag/eksport.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
